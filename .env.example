# ==============================================================================
# EduGuide AI - Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth Credentials
# Obtain these from the Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# IMPORTANT FOR VERCEL DEPLOYMENT:
# In Google Cloud Console, add to "Authorized redirect URIs":
#   - http://localhost:3000/api/auth/callback/google (Local Development)
#   - https://<your-vercel-domain>.vercel.app/api/auth/callback/google (Production Vercel)
# And add to "Authorized JavaScript origins":
#   - http://localhost:3000
#   - https://<your-vercel-domain>.vercel.app
# ------------------------------------------------------------------------------
# Server-side Google Client ID used by NextAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Client-accessible Google Client ID for browser checks and Google SDK
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Google Client Secret (Keep this private, NEVER expose with NEXT_PUBLIC_)
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# NextAuth / Auth.js Configuration
# ------------------------------------------------------------------------------
# Base URL of the application.
# For local development: http://localhost:3000
# For Vercel production: https://<your-vercel-domain>.vercel.app (or custom domain)
NEXTAUTH_URL="http://localhost:3000"

# A secure random 32-byte secret used to sign session cookies and JWT tokens.
# You can generate one via: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-32-byte-secret"
